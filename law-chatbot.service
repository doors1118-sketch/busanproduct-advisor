[Unit]
Description=법령챗봇 AI 어드바이저 (Streamlit 독립 서비스)
After=network.target

[Service]
Type=simple
User=busan-chatbot
Group=busan-chatbot
WorkingDirectory=/opt/advisor
EnvironmentFile=/opt/advisor/pilot_auth.env
Environment=CHATBOT_API_URL=http://127.0.0.1:8001/chat
ExecStart=/usr/local/bin/streamlit run app/pages/💬_법령챗봇.py --server.port 8502 --server.address 0.0.0.0 --server.headless true
Restart=always
RestartSec=10
Environment=PATH=/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
