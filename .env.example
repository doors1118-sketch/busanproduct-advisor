# v1.4.4 환경변수 설정 예시
# 실제 API key는 포함하지 마세요.

# ─── Feature Flag ───
PROMPT_MODE=dynamic_v1_4_4
# legacy: 기존 system_prompt.py 사용
# dynamic_v1_4_4: Core + Guardrail 동적 조립

APP_ENV=local
# local: logs/*.jsonl 파일 로깅
# prod: stdout structured logging

# ─── 모델 설정 ───
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-pro
ROUTER_MODEL=gemini-2.5-flash
FALLBACK_MODEL=gemini-2.5-flash

# ─── 모델 라우팅 정책 ───
# risk_based: 저위험 → Flash, 고위험 → Pro (비용 절감 + 품질 유지)
# pro_only: 모든 질문에 Pro 사용
# flash_only: 모든 질문에 Flash 사용 (테스트용)
MODEL_ROUTING_MODE=risk_based

# ─── Function Calling ───
MAX_TOOL_CALL_ROUNDS=3
LLM_TOOL_LOOP_ENABLED=false

# ─── 자연어 Writer 후처리 ───
# 서버가 계약판단/근거/후보표를 먼저 확정하고, Gemini가 짧은 본문만 자연스럽게 다듬습니다.
# 후보표·근거표는 Gemini에 보내지 않고 서버가 원문 그대로 나중에 붙입니다.
NATURAL_LANGUAGE_WRITER_ENABLED=true
NATURAL_LANGUAGE_WRITER_MODE=selective
NATURAL_LANGUAGE_WRITER_MODEL=gemini-2.5-flash
NATURAL_LANGUAGE_WRITER_TIMEOUT_SEC=15
NATURAL_LANGUAGE_WRITER_MAX_INPUT_CHARS=3500
NATURAL_LANGUAGE_WRITER_MIN_INPUT_CHARS=180
NATURAL_LANGUAGE_WRITER_MAX_PRIOR_MODEL_MS=12000

# ─── MCP 서버 설정 ───
MCP_ENDPOINT=https://your-mcp-server.example.com
LAW_OC=your_law_oc_here

# ─── 업체 검색 API ───
COMPANY_API_KEY=your_company_api_key_here
ODCLOUD_API_KEY=your_odcloud_api_key_here

# ─── 챗봇 런타임: Company API ───
# true(기본값): Mock 데이터 사용 / false: 실제 모니터링 시스템 API 호출
USE_MOCK_COMPANY_API=true
# 모니터링 시스템 API 서버 주소 (USE_MOCK_COMPANY_API=false 일 때 사용)
MONITORING_COMPANY_API_BASE_URL=http://127.0.0.1:8000

# ─── 챗봇 런타임: Item Eligibility ───
# true(기본값): Mock JSON 사용 / false: 모니터링 시스템 API 실시간 조회
USE_MOCK_ITEM_ELIGIBILITY=true

# ─── MCP 도구별 Timeout (초) ───
MCP_CHAIN_TIMEOUT_SECONDS=12
MCP_LAW_TEXT_TIMEOUT_SECONDS=10
MCP_ADMIN_RULE_TIMEOUT_SECONDS=10
MCP_DECISION_TIMEOUT_SECONDS=5
MCP_ORDINANCE_TIMEOUT_SECONDS=8

# ─── 캐시 ───
CACHE_TTL_SECONDS=3600
